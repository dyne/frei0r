{
  "name": "frei0r-website",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vitepress dev",
    "demo:check": "svelte-check --tsconfig ./tsconfig.demo.json",
    "demo:test:camera": "node scripts/test-demo-camera.mjs && npm run demo:check",
    "demo:test:frame-pipeline": "node scripts/test-demo-frame-pipeline.mjs && npm run demo:check",
    "demo:test:frame-scheduler": "node scripts/test-demo-frame-scheduler.mjs && npm run demo:check",
    "demo:test:filter-parameters": "node scripts/test-demo-filter-parameters.mjs && npm run demo:check",
    "demo:test:filter-catalog": "node scripts/test-demo-filter-catalog.mjs && npm run demo:check",
    "demo:test:filter-navigation": "node scripts/test-demo-filter-navigation.mjs && npm run demo:check",
    "demo:test:feedback": "node scripts/test-demo-feedback-state.mjs && npm run demo:check",
    "demo:test:browser": "node scripts/test-demo-browser-smoke.mjs",
    "demo:test:a11y": "node scripts/audit-demo-accessibility.mjs",
    "demo:test:stage": "node scripts/test-demo-stage-state.mjs && npm run demo:check",
    "demo:check:build": "node scripts/check-demo-build.mjs",
    "demo:dev": "vite --config vite.demo.config.ts",
    "demo:prepare-runtime": "node scripts/prepare-demo-runtime.mjs",
    "demo:write-service-worker": "node scripts/write-demo-service-worker.mjs",
    "demo:test:service-worker": "node scripts/test-demo-service-worker.mjs",
    "demo:build": "npm run demo:prepare-runtime && vite build --config vite.demo.config.ts && npm run demo:write-service-worker",
    "demo:preview": "vite preview --config vite.demo.config.ts",
    "docs:api": "node scripts/build-api.mjs",
    "docs:check-links": "node scripts/check-documentation-links.mjs",
    "build": "npm run docs:api && npm run build:site && npm run demo:build",
    "build:site": "vitepress build",
    "check": "npm run docs:check-links && node scripts/check-site.mjs && npm run demo:check:build",
    "preview": "vitepress preview"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@sveltejs/vite-plugin-svelte": "^6.2.4",
    "@types/node": "^24.10.1",
    "playwright": "^1.63.0",
    "svelte": "^5.50.0",
    "svelte-check": "^4.3.4",
    "typescript": "^5.9.3",
    "vite": "^7.3.3",
    "vitepress": "^2.0.0-alpha.17",
    "vue": "^3.5.32"
  }
}
